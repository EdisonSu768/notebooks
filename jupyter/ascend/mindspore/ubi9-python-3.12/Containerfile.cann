ARG TARGETARCH
ARG GIT_HTTPS_PROXY=http://192.168.144.12:7890

#########################
# configuration args    #
#########################
ARG BASE_IMAGE

######################################################
# mongocli-builder (build stage only, not published) #
######################################################
FROM registry.access.redhat.com/ubi9/go-toolset:latest AS mongocli-builder

ARG TARGETARCH
ARG MONGOCLI_VERSION=2.0.4
ARG GIT_HTTPS_PROXY

WORKDIR /tmp/

RUN /bin/bash <<'EOF'
set -Eeuxo pipefail
arch="${TARGETARCH:-$(uname -m)}"
arch=$(echo "$arch" | cut -d- -f1)
echo "Building mongocli for ${arch}"
if [ -n "${GIT_HTTPS_PROXY}" ]; then
    export HTTPS_PROXY="${GIT_HTTPS_PROXY}"
    export https_proxy="${GIT_HTTPS_PROXY}"
fi
curl -Lo mongodb-cli-mongocli-v${MONGOCLI_VERSION}.zip https://github.com/mongodb/mongodb-cli/archive/refs/tags/mongocli/v${MONGOCLI_VERSION}.zip
unzip ./mongodb-cli-mongocli-v${MONGOCLI_VERSION}.zip
cd ./mongodb-cli-mongocli-v${MONGOCLI_VERSION}/
CGO_ENABLED=1 GOOS=linux GOARCH=${arch} GO111MODULE=on go build -a -tags strictfipsruntime -o /tmp/mongocli ./cmd/mongocli/
EOF

####################
# cann-base        #
####################
FROM ${BASE_IMAGE} AS cann-base

WORKDIR /opt/app-root/bin

USER 0

RUN /bin/bash <<'EOF'
set -Eeuxo pipefail
dnf install -y perl mesa-libGL skopeo
dnf clean all
rm -rf /var/cache/yum
test -f /usr/local/Ascend/cann/set_env.sh
test -f /usr/local/Ascend/nnal/atb/set_env.sh
if [ ! -e /usr/local/Ascend/ascend-toolkit ]; then
    ln -s /usr/local/Ascend/cann /usr/local/Ascend/ascend-toolkit
fi
fix-permissions /usr/local/Ascend -P
EOF

ENV ASCEND_TOOLKIT_HOME=/usr/local/Ascend/cann \
    ASCEND_OPS_HOME=/usr/local/Ascend/ops \
    ASCEND_NNAL_HOME=/usr/local/Ascend/nnal \
    LD_LIBRARY_PATH=/usr/local/Ascend/cann/lib64:/usr/local/Ascend/nnal/atb/lib:$LD_LIBRARY_PATH \
    PATH=/usr/local/Ascend/cann/bin:/usr/local/Ascend/nnal/atb/bin:$PATH

USER 1001

### BEGIN Install micropipenv and uv to deploy packages from requirements.txt
RUN pip install --no-cache-dir --index-url https://pypi.tuna.tsinghua.edu.cn/simple -U "micropipenv[toml]==1.10.0" "uv==0.10.8"
### END Install micropipenv and uv to deploy packages from requirements.txt

#########################
# cann-jupyter-minimal  #
#########################
FROM cann-base AS cann-jupyter-minimal

ARG JUPYTER_REUSABLE_UTILS=jupyter/utils
ARG MINIMAL_SOURCE_CODE=jupyter/ascend/minimal/ubi9-python-3.12

WORKDIR /opt/app-root/bin

COPY ${JUPYTER_REUSABLE_UTILS} utils/

COPY ${MINIMAL_SOURCE_CODE}/start-notebook.sh ./

USER 0

### BEGIN Dependencies for PDF export
RUN ./utils/install_pdf_deps.sh
ENV PATH="/usr/local/texlive/bin/linux:/usr/local/pandoc/bin:$PATH"
### END Dependencies for PDF export

USER 1001

WORKDIR /opt/app-root/src

ENTRYPOINT ["start-notebook.sh"]

#############################
# cann-jupyter-datascience  #
#############################
FROM cann-jupyter-minimal AS cann-jupyter-datascience

ARG DATASCIENCE_SOURCE_CODE=jupyter/ascend/datascience/ubi9-python-3.12

WORKDIR /opt/app-root/bin

USER root

RUN /bin/bash <<'EOF'
set -Eeuxo pipefail
dnf install -y jq unixODBC unixODBC-devel postgresql git-lfs libsndfile libxcrypt-compat protobuf
dnf clean all
rm -rf /var/cache/yum
EOF

COPY --from=mongocli-builder /tmp/mongocli /opt/app-root/bin/

USER 1001

COPY ${DATASCIENCE_SOURCE_CODE}/setup-elyra.sh ${DATASCIENCE_SOURCE_CODE}/utils ./utils/

WORKDIR /opt/app-root/src

#############################
# cann-jupyter-mindspore    #
#############################
FROM cann-jupyter-datascience AS cann-jupyter-mindspore

ARG MINDSPORE_SOURCE_CODE=jupyter/ascend/mindspore/ubi9-python-3.12
ARG PYLOCK_FLAVOR
ARG TARGETARCH
ARG MINDSPORE_VERSION=2.8.0
ARG MINDSPEED_CORE_MS_BRANCH=master
ARG MINDSPEED_CORE_MS_COMMIT=15c32460f9ba04d4d4ca7b50cbe07344cdb4f12c
ARG MSADAPTER_BRANCH=master
ARG MSADAPTER_COMMIT=79d4868844313341da6c4da6f22708eea0f34a84

ENV ATB_SET_ENV_ARGS=--cxx_abi=0 \
    MINDSPEED_CORE_MS_PATH=/opt/app-root/share/MindSpeed-Core-MS \
    MINDSPORE_VERSION=${MINDSPORE_VERSION} \
    MINDSPEED_CORE_MS_BRANCH=${MINDSPEED_CORE_MS_BRANCH} \
    MINDSPEED_CORE_MS_COMMIT=${MINDSPEED_CORE_MS_COMMIT} \
    MSADAPTER_BRANCH=${MSADAPTER_BRANCH} \
    MSADAPTER_COMMIT=${MSADAPTER_COMMIT} \
    GIT_HTTPS_PROXY=${GIT_HTTPS_PROXY}

LABEL name="odh-notebook-jupyter-mindspore-cann-ubi9-python-3.12" \
    summary="Jupyter MindSpore notebook image with Ascend 910B support" \
    description="Jupyter MindSpore notebook image for ARM64 with CANN 8.5.0 and MindSpore ${MINDSPORE_VERSION}" \
    authoritative-source-url="https://github.com/opendatahub-io/notebooks"

WORKDIR /opt/app-root/bin

COPY ${MINDSPORE_SOURCE_CODE}/uv.lock.d/pylock.${PYLOCK_FLAVOR}.toml ./pylock.toml
COPY --chmod=0755 jupyter/ascend/install-mindspore-npu.sh ./install-mindspore-npu.sh
COPY --chmod=0755 ${MINDSPORE_SOURCE_CODE}/hf_to_mcore_msadapter_compat.sh ./hf_to_mcore_msadapter_compat.sh
COPY --chmod=0755 ${MINDSPORE_SOURCE_CODE}/mindspeed_msadapter_runtime_compat.sh ./mindspeed_msadapter_runtime_compat.sh
COPY --chown=1001:0 --chmod=0664 ${MINDSPORE_SOURCE_CODE}/odh_mindspore_msadapter_compat.py ${MINDSPORE_SOURCE_CODE}/odh_mindspore_msadapter_compat.pth /opt/app-root/lib/python3.12/site-packages/
COPY --chown=1001:0 --chmod=0664 ${MINDSPORE_SOURCE_CODE}/odh_mindspore_msadapter_compat.py ${MINDSPORE_SOURCE_CODE}/odh_mindspore_msadapter_compat.pth /opt/app-root/lib64/python3.12/site-packages/

RUN /bin/bash <<'EOF'
set -Eeuxo pipefail

UV_NO_CACHE=true UV_LINK_MODE=copy UV_PREVIEW_FEATURES=pylock uv pip install \
    --strict --no-deps --no-config --no-progress \
    --require-hashes --compile-bytecode --index-strategy=unsafe-best-match \
    --requirements=./pylock.toml

./install-mindspore-npu.sh
rm -f ./install-mindspore-npu.sh

mkdir -p /opt/app-root/runtimes /opt/app-root/pipeline-runtimes
rm -f /opt/app-root/share/jupyter/metadata/runtime-images/*.json || true
sed -i -e "s/Python.*/$(python --version | cut -d '.' -f-2)\",/" /opt/app-root/share/jupyter/kernels/python3/kernel.json
install -D -m 0644 /opt/app-root/bin/utils/jupyter_server_config.py /opt/app-root/etc/jupyter/jupyter_server_config.py
jupyter labextension disable "@jupyterlab/apputils-extension:announcements"
/opt/app-root/bin/utils/addons/apply.sh
chmod -R g+w /opt/app-root/lib/python3.12/site-packages
fix-permissions /opt/app-root -P
EOF

WORKDIR /opt/app-root/src

ENTRYPOINT ["start-notebook.sh"]
